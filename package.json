{
  "name": "at-astro-loader",
  "version": "1.3.1",
  "private": false,
  "description": "An Astro content loader for records on ATProto.",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-loader",
    "atproto",
    "atprotocol",
    "bluesky",
    "content-collections",
    "withastro"
  ],
  "homepage": "https://github.com/chrisvander/at-astro-loader",
  "repository": "git+https://github.com/chrisvander/at-astro-loader.git",
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./lexicons": "./dist/lexicons.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsgo",
    "test": "bun test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "gen": "lex build --clear",
    "postinstall": "bun gen"
  },
  "dependencies": {
    "escape-html": "^1.0.3",
    "katex": "^0.18.4",
    "shiki": "^4.4.3",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@atproto/lex-json": "^0.1.6",
    "@atproto/lex-schema": "^0.2.5",
    "@types/bun": "^1.4.0",
    "@types/escape-html": "^1.0.4",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@atproto/lex": "^0.3.6",
    "astro": "^7.2.4"
  }
}
