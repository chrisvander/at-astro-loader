{
  "name": "at-astro-loader",
  "version": "1.1.0",
  "private": false,
  "description": "An Astro content loader for records on ATProto.",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-loader",
    "atproto",
    "atprotocol",
    "bluesky",
    "content-collections",
    "withastro"
  ],
  "homepage": "https://github.com/chrisvander/at-astro-loader",
  "repository": "git+https://github.com/chrisvander/at-astro-loader.git",
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./lexicons": "./dist/lexicons.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsgo",
    "test": "bun test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "gen": "lex build --clear",
    "postinstall": "bun gen"
  },
  "dependencies": {
    "slugify": "^1.6.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@atproto/lex-json": "^0.0.16",
    "@atproto/lex-schema": "^0.0.19",
    "@types/bun": "^1.3.12",
    "@typescript/native-preview": "^7.0.0-dev.20260420.1",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@atproto/lex": "^0.0.25",
    "astro": "^6.1.8"
  }
}
